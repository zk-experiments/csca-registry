//! Tests against vectors generated by the csca-registry crate (src/vectors.nr).

use crate::{
    country_from_mrz, hash, key_hash, key_leaf, KEY_TREE_HEIGHT, merkle_root, MerklePath, pack_be,
    REVOCATION_TREE_HEIGHT, state_root, verify_key, verify_not_revoked,
};
use crate::vectors::{
    DE_AT, de_header, DE_KEY, DE_KEY_HASH, DE_LEAF, de_path, exclusion_after, exclusion_before,
    exclusion_between, IT_AT, it_header, IT_KEY, IT_KEY_HASH, IT_LEAF, it_path, KEYS_ROOT,
    REV_ISSUER_KEY_HASH, REVOCATIONS_ROOT, REVOKED_SERIAL, ROOT, SERIAL_AFTER, SERIAL_BEFORE,
    SERIAL_BETWEEN,
};

#[test]
fn poseidon2_matches_pso_poseidon() {
    // Known answers shared with csca-registry commitment.rs.
    assert_eq(hash([1, 2]), 0x038682aa1cb5ae4e0a3f13da432a95c77c5c111f6f030faf9cad641ce1ed7383);
    // len % 3 == 0 has no trailing permutation; csca-registry's commitment.rs locks the same value.
    assert_eq(hash([1, 2, 3]), 0x23864adb160dddf590f1d3303683ebcb914f828e2635f6e85a32f0a1aecd3dd8);
}

#[test]
fn pack_puts_least_significant_chunk_first() {
    let mut bytes: [u8; 33] = [0; 33];
    for i in 0..33 {
        bytes[i] = (i + 1) as u8;
    }
    let f: [Field; 2] = pack_be(bytes);
    assert_eq(f[1], 0x0102);
    assert_eq(f[0], 0x030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021);
}

#[test]
fn leaves_match_the_registry() {
    assert_eq(key_hash::<128, 5>(DE_KEY), DE_KEY_HASH);
    assert_eq(key_leaf(de_header(), DE_KEY_HASH), DE_LEAF);
    assert_eq(key_hash::<512, 17>(IT_KEY), IT_KEY_HASH);
    assert_eq(key_leaf(it_header(), IT_KEY_HASH), IT_LEAF);
}

#[test]
fn paths_reach_the_registry_root() {
    assert_eq(state_root(KEYS_ROOT, REVOCATIONS_ROOT), ROOT);
    assert_eq(merkle_root(DE_LEAF, de_path()), KEYS_ROOT);
    assert_eq(merkle_root(IT_LEAF, it_path()), KEYS_ROOT);
}

#[test]
fn verifies_brainpool_p512_key() {
    let kh = verify_key::<128, 5>(
        ROOT,
        REVOCATIONS_ROOT,
        de_header(),
        DE_KEY,
        de_path(),
        DE_AT,
    );
    assert_eq(kh, DE_KEY_HASH);
}

#[test]
fn verifies_rsa_4096_key() {
    let kh = verify_key::<512, 17>(
        ROOT,
        REVOCATIONS_ROOT,
        it_header(),
        IT_KEY,
        it_path(),
        IT_AT,
    );
    assert_eq(kh, IT_KEY_HASH);
}

#[test(should_fail_with = "CSCA key period has not opened at the given date")]
fn rejects_date_before_period() {
    let h = de_header();
    let _ = verify_key::<128, 5>(ROOT, REVOCATIONS_ROOT, h, DE_KEY, de_path(), h.open - 1);
}

#[test(should_fail_with = "CSCA key period has closed at the given date")]
fn rejects_date_after_period() {
    let h = de_header();
    let _ = verify_key::<128, 5>(ROOT, REVOCATIONS_ROOT, h, DE_KEY, de_path(), h.close + 1);
}

#[test(should_fail_with = "registry root mismatch")]
fn rejects_widened_period() {
    // Claiming a longer validity changes the leaf, so the path no longer reaches the root.
    let mut h = de_header();
    h.close += 1;
    let _ = verify_key::<128, 5>(ROOT, REVOCATIONS_ROOT, h, DE_KEY, de_path(), DE_AT);
}

#[test(should_fail_with = "registry root mismatch")]
fn rejects_other_country() {
    let mut h = de_header();
    h.country = [0x46, 0x52, 0x41]; // FRA
    let _ = verify_key::<128, 5>(ROOT, REVOCATIONS_ROOT, h, DE_KEY, de_path(), DE_AT);
}

#[test(should_fail_with = "registry root mismatch")]
fn rejects_tampered_path() {
    let p = de_path();
    let mut siblings = p.siblings;
    siblings[3] += 1;
    let _ = verify_key::<128, 5>(
        ROOT,
        REVOCATIONS_ROOT,
        de_header(),
        DE_KEY,
        MerklePath::<KEY_TREE_HEIGHT> { index: p.index, siblings },
        DE_AT,
    );
}

#[test(should_fail_with = "registry root mismatch")]
fn rejects_substituted_key() {
    // The IT key with the DE leaf's header and path.
    let mut key: [u8; 128] = [0; 128];
    for i in 0..128 {
        key[i] = IT_KEY[i];
    }
    let _ = verify_key::<128, 5>(ROOT, REVOCATIONS_ROOT, de_header(), key, de_path(), DE_AT);
}

#[test]
fn non_revoked_serials_are_excluded() {
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        SERIAL_BEFORE,
        exclusion_before(),
    );
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        SERIAL_BETWEEN,
        exclusion_between(),
    );
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        SERIAL_AFTER,
        exclusion_after(),
    );
}

#[test(should_fail)]
fn revoked_serial_has_no_exclusion_before() {
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        REVOKED_SERIAL,
        exclusion_before(),
    );
}

#[test(should_fail)]
fn revoked_serial_has_no_exclusion_between() {
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        REVOKED_SERIAL,
        exclusion_between(),
    );
}

#[test(should_fail)]
fn revoked_serial_has_no_exclusion_after() {
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        REVOKED_SERIAL,
        exclusion_after(),
    );
}

#[test(should_fail)]
fn exclusion_is_bound_to_the_issuer_key() {
    // A witness for one serial does not carry over to another serial.
    verify_not_revoked(
        REVOCATIONS_ROOT,
        REV_ISSUER_KEY_HASH,
        SERIAL_AFTER,
        exclusion_before(),
    );
}

#[test]
fn normalises_german_mrz_code() {
    assert_eq(country_from_mrz([0x44, 0x3c, 0x3c]), [0x44, 0x45, 0x55]);
    assert_eq(country_from_mrz([0x49, 0x54, 0x41]), [0x49, 0x54, 0x41]);
}

#[test]
fn tree_heights() {
    assert_eq(KEY_TREE_HEIGHT, 16);
    assert_eq(REVOCATION_TREE_HEIGHT, 14);
}
